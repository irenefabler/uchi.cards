# Copy into .env.development.local for local Docker backend.
VITE_PROXY_PATH_BACKEND=/api/v1
VITE_PROXY_URL=http://127.0.0.1:8080
# Local dev proxy only. Never set an identity header in production/client code.
VITE_DEV_USER_ID=42
# Only available in Vite development mode; fixed sample, no OCR/external requests.
VITE_DEMO_GENERATION=true
