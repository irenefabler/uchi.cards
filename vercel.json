{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/quizlet", "permanent": false }
  ],
  "rewrites": [
    { "source": "/quizlet/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/quizlet", "destination": "/index.html" },
    { "source": "/quizlet/:path*", "destination": "/index.html" }
  ]
}
